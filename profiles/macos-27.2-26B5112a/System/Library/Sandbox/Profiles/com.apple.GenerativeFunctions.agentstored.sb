
;;; Copyright (c) 2021 Apple Inc. All Rights reserved.
(version 1)
(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)
(deny mach-priv-host-port)
(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)
;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))
(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))
(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))
(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))
(allow process-info* (target self))
(allow process-info-dirtycontrol (target self))
;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)
;; For validating the entitlements of clients.
(allow process-info-codesignature)
(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
    (preference-domain "com.apple.CloudKit")
)
(allow user-preference-read user-preference-write
    (preference-domain "com.apple.GenerativeFunctions.agentstored")
    (preference-domain "com.apple.GenerativeModels.AgentSessionKit")
)
(allow file-read* file-write*
   (subpath (param "TMPDIR"))
   (subpath (param "DARWIN_CACHE_DIR"))
   (mount-relative-literal "/.TemporaryItems")
   (mount-relative-regex #"^/\.TemporaryItems/folders.[0-9]+(/|$)")
   (home-subpath "/Library/AppleIntelligencePlatform/") ;; AgentSessionKit database and related files
   (home-subpath "/Library/Shortcuts/") ;; ToolDatabase
   (home-subpath "/Library/AgentSessionKitBackupStaging/") ;; Press-demo backup staging (rdar:
)
;; Trial factor levels. This profile is macOS-only, where agentstored is a LaunchAgent, so the
;; data vault is the home-relative one.
(allow file-read* (home-subpath "/Library/Trial"))
;; Issue sandbox read extensions for owned file artifacts to requesting clients
(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read")
        (extension "com.apple.sandbox.container")))
;; Internal Daemon Data Container
(allow file-read* file-write* (extension "com.apple.sandbox.container"))
(allow mach-lookup (global-name "com.apple.containermanagerd"))
;; Consume sandbox extensions
(with-filter (extension "com.apple.app-sandbox.read")
    (allow file-read*)
    (allow file-issue-extension (extension-class "com.apple.app-sandbox.read")))
(with-filter (extension "com.apple.app-sandbox.read-write")
    (allow file-read* file-write*)
    (allow file-issue-extension (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")))
(allow mach-lookup
    (global-name "com.apple.cloudd")
    (global-name "com.apple.apsd")
    (global-name "com.apple.kvsd")
    (global-name "com.apple.cascade.donationrequest.Siri.Transcript.Turn")
    (global-name "com.apple.duetactivityscheduler")
    ;; APSConnection access for CK push
    (global-name "com.apple.windowserver.active")
    (global-name "com.apple.SystemConfiguration.configd")
    ;; BackgroundSystemTasks scheduling (DAS)
    (global-name "com.apple.duetactivityscheduler")
    ;; LaunchServices database access for UTType resolution (required by Photos ingest)
    (global-name "com.apple.lsd.mapdb")
    ;; LaunchServices server connection for AppIntentsServices entity resolution (app launch)
    (global-name "com.apple.coreservices.launchservicesd")
    ;; Photos library access
    (global-name "com.apple.photos.service")
    (global-name "com.apple.tccd")
    (global-name "com.apple.tccd.system")
    ;; Account dataclass check
    (global-name "com.apple.accountsd.accountmanager")
    ;; Generative search access
    (global-name "com.apple.generativesearch.server.search")
    ;; Cascade indexing
    (global-name "com.apple.SetStoreUpdateService")
    ;; Entity Resolution via AppIntentsServices / LinkServices
    (global-name "com.apple.linkd.registry")
    (global-name "com.apple.linkd.extension")
    (global-name "com.apple.linkd.mediator")
    (global-name "com.apple.linkd.application-service")
    (global-name "com.apple.biome.access.user")
    (global-name "com.apple.biome.access.system")
    (global-name "com.apple.biome.compute.publisher.service")
    (global-name "com.apple.biome.compute.publisher.service.user")
    (global-name "com.apple.biome.compute.source")
    (global-name "com.apple.biome.compute.source.user")
    ;; AuthKit XPC services
    (global-name "com.apple.ak.auth.xpc")
)
;; MSDCDemoState.isSecureDemoModeEnabled -> CP_GetDeviceConfigurationBits (store-demo check)
(allow file-read*
    (literal "/private/var/db/ConfigurationProfiles/Settings/.deviceConfigurationBits"))
(allow iokit-open
    (iokit-user-client-class "AppleKeyStoreUserClient"))
;; Allow posting distributed notification for first turn of agent session
(allow distributed-notification-post)
