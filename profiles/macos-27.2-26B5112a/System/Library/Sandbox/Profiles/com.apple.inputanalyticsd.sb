;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(allow network-outbound)

(import "system.sb")
(system-network)

(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Specific preference domain for inputanalyticsd
(allow user-preference-read user-preference-write
    (preference-domain "com.apple.inputanalyticsd")
    (preference-domain "com.apple.inputAnalytics.serverStats")
    (preference-domain "com.apple.inputAnalytics.IASWTAnalyzer")
    (preference-domain "com.apple.inputAnalytics.IASSRAnalyzer")
    (preference-domain "com.apple.inputAnalytics.IASGenmojiAnalyzer")
    (preference-domain "com.apple.inputAnalytics.IASGenmojiUsageAnalyzer")
    (preference-domain "com.apple.inputAnalytics.IASImageGenerationCreationAnalyzer")
)

;; Additional preference domains
(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
    (preference-domain "com.apple.gms.availability")
    (preference-domain "com.apple.siri.generativeassistantsettings")
    ;; Siri assistant enablement for Writing Tools daily event
    (preference-domain "com.apple.assistant.support")
    ;; Smart Actions enablement: Predictive Text and per-app "Show in App" Siri suggestions
    (preference-domain "com.apple.keyboard.preferences")
    (preference-domain "com.apple.suggestions")
    ;; Mail "Personalize Smart Replies" consent (group.com.apple.mail), read by the Smart Reply daily event
    (preference-domain "group.com.apple.mail")
)

;; Read/write access to a temporary directory.
(allow file-read* file-write*
    (subpath (param "TMPDIR"))
    (subpath (param "DARWIN_CACHE_DIR"))
)

(allow file-read-data
    (literal "/Library/Preferences/com.apple.networkd.plist")
)

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.inputanalyticsd")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))
      
;; Group container access
(allow file-read* file-write*
    (extension "com.apple.sandbox.application-group"))

;; Read access to additional relevant files and directories
(allow file-read*
    (literal "/usr/libexec")
    (literal "/usr/libexec/inputanalyticsd")
    (literal "/private/var/db/eligibilityd/eligibility.plist")
)

(allow file-read*
       (subpath "/private/var/mobile/Library/Stickers"))

(allow user-preference-read
    (preference-domain "com.apple.stickers")
)


;; Access to Mach services
(allow mach-lookup
    (global-name "com.apple.duetactivityscheduler")
    (global-name "com.apple.generativeexperiences.availabilityService")
    (global-name "com.apple.securityd.systemkeychain")
    (global-name "com.apple.containermanagerd")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.lsd.advertisingidentifiers")
    (global-name "com.apple.feedbackd.centralized-feedback")
    (global-name "com.apple.biome.access.user")
    (global-name "com.apple.biome.access.system")
    (global-name "com.apple.biome.compute.publisher.service.user")
    (global-name "com.apple.biome.compute.publisher.service")
    (global-name "com.apple.stickers.api")
)

(allow iokit-open
    (iokit-user-client-class "AppleKeyStoreUserClient"))
