(version 1)

(import "appsandbox-common.sb")
(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

(allow default (with report))

(allow file-read* file-write*
    (regex #"/Library/Metadata/CoreSpotlight/DocumentProcessing"))

(allow process-info* (target self))
(allow process-info-pidinfo (target others))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

(allow file-link)

(allow mach-lookup
    (global-name "com.apple.biome.access.user")
    (global-name "com.apple.spotlight.IndexAgent")
    (global-name "com.apple.powerlog.plxpclogger.xpc")
    (global-name "com.apple.FileDerivativeService")
)
