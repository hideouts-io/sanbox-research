;;;
;;; Sandbox profile for mdworker (Spotlight metadata server worker)
;;; with additional rules for Application.mdimporter (Application metadata importer)
;;;
;;; Copyright (c) 2006–2026 Apple Inc.  All Rights reserved.
;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;

(version 1)

(import "mdworker.sb")

;; Allow Application importer to assess app bundle code signing and security policy
(allow mach-lookup
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.security.syspolicy"))

(allow file-read*
    (literal "/Library/Preferences/com.apple.security.plist"))

(if (positive? (string-length (param "_HOME")))
    (begin
        (allow file-read* (home-literal "/Library/Preferences/com.apple.security.plist"))
        (allow file-read* (home-literal "/Library/Preferences/com.apple.security.revocation.plist"))))
