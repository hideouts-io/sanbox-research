;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(system-network)
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.privatecloudcomputed")
       (preference-domain "com.apple.privateCloudCompute.client")
       (preference-domain "com.apple.privateCloudCompute")
       (preference-domain "com.apple.privatecloudcompute")
       (preference-domain "kCFPreferencesAnyApplication"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
      (subpath (param "DARWIN_USER_TEMP_DIR"))
      (subpath (param "DARWIN_USER_CACHE_DIR")))
       
;; Read/write access to our sqlite dbs
(allow file-read* file-write*
       (home-subpath "/Library/PrivateCloudCompute"))

;; Read access to network plist
(allow file-read-data (literal "/Library/Preferences/com.apple.networkd.plist"))

;; Read access to shared cfprefs
(allow file-read*
    (literal "/Library/Preferences/com.apple.privateCloudCompute.plist"))

(allow user-preference-read
    (preference-domain "com.apple.CloudAttestation")
    (preference-domain "com.apple.AppleIntelligenceReport")
    (preference-domain "com.apple.CloudSubscriptionFeatures.gmBypass"))

;; OSAnalytics fallback
(allow file-read*
    (literal "/Library/OSAnalytics/Preferences/"))

;; Mach Services
(allow mach-lookup
       (global-name "com.apple.dnssd.service")
       (global-name "com.apple.usymptomsd")
       (global-name "com.apple.PowerManagement.control")
       (global-name "com.apple.SystemConfiguration.configd")
       (global-name "com.apple.swtransparencyd")
       (global-name "com.apple.networkserviceproxy")
       (global-name "com.apple.duetactivityscheduler")
       (global-name "com.apple.biome.access.user") ; For Biome logging
       (global-name "com.apple.biome.access.system") ; For Biome logging
       (global-name "com.apple.containermanagerd")) ; For Daemon Container
       (global-name "com.apple.SBUserNotification") ; For build expiration notification

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.privatecloudcomputed")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; For internal daemon data containers, app data containers, plugin data containers
(allow file-read* file-write*
    (extension "com.apple.sandbox.container"))

;; Allow outbound network access
(allow network-outbound
    (remote ip)
)
