;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

;;; Hardened sandbox profile - training wheels removed
(deny default)

;; Only allow specific file-map-executable operations that are needed
(allow file-map-executable
       (literal "/usr/lib/dyld")
       (subpath "/System/Library/")
       (subpath "/usr/lib/"))

;; Restrict process-info to only what's needed
(allow process-info-pidinfo (target self))
(allow process-info-setcontrol (target self))

;; Deny dynamic code generation for security
(deny dynamic-code-generation)

;; Deny nvram access - not needed for peopled
(deny nvram*)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Networking
(allow system-socket)
(allow network-outbound)

;; IOKit
(allow iokit-get-properties)
(allow iokit-open
    (iokit-user-client-class        "AppleKeyStoreUserClient"
                                    "RootDomainUserClient")
)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.addressbook"
                          "com.apple.familycircle"
                          "com.apple.messages"
                          "com.apple.mobilesms"
                          "${com.apple.peopled}"
                          "com.apple.people"
                          "kcfpreferencesanyapplication"
        )
)

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath "/private/var/db/nsurlstoraged/dafsaData.bin")
       (subpath "/Library/Preferences/com.apple.networkd.plist")
       (home-subpath "/Library/CallHistoryDB/")
       (home-subpath "/Library/Logs/CallHistory")
       (regex #"^/private/var/folders/[^/]+/[^/]+/T/\.AddressBookLocks.*")
)
;;       (subpath (param "DARWIN_CACHE_DIR")))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.peopled")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; Mach-lookup
(allow mach-lookup
    (global-name    "com.apple.accountsd.accountmanager"
                    "com.apple.AddressBook.abd"
                    "com.apple.AddressBook.ContactsAccountsService"
                    "com.apple.AppSSO.service-xpc"
                    "com.apple.biome.PublicStreamAccessService"
                    "com.apple.biome.access.user"
                    "com.apple.biome.compute.publisher.service.user"
                    "com.apple.biome.compute.source.user"
                    "com.apple.calaccessd"
                    "com.apple.CalendarAgent"
                    "com.apple.CallHistorySyncHelper"
                    "com.apple.chronoservices"
                    "com.apple.contacts.account-caching"
                    "com.apple.contactsd.persistence"
                    "com.apple.contacts.poster.api"
                    "com.apple.coreduetd.people"
                    "com.apple.corerecents.recentsd"
                    "com.apple.dnssd.service"
                    "com.apple.familycircle.agent"
                    "com.apple.findmy.findmylocate.friendshipservice"
                    "com.apple.findmy.findmylocate.locationservice"
                    "com.apple.findmy.findmylocate.settings"
                    "com.apple.geod"
                    "com.apple.icloud.findmydeviced.app-support"
                    "com.apple.icloud.searchpartyd.securelocations"
                    "com.apple.identityservicesd.desktop.auth"
                    "com.apple.identityservicesd.idquery.desktop.auth"
                    "com.apple.imagent.desktop.auth"
                    "com.apple.imagent.embedded.auth"
                    "com.apple.imdpersistence.IMDPersistenceAgent"
                    "com.apple.linkd.autoShortcut"
                    "com.apple.linkd.mediator"
                    "com.apple.linkd.transcript"
                    "com.apple.logind"
                    "com.apple.remindd"
                    "com.apple.ScreenTimeAgent.downtime"
                    "com.apple.spotlight.IndexAgent"
                    "com.apple.StatusKit.subscribe"
                    "com.apple.system.opendirectoryd.api"
                    "com.apple.SystemConfiguration.configd"
                    "com.apple.tccd"
                    "com.apple.tccd.system"
                    "com.apple.usymptomsd"
    )
)
