;;; Copyright (c) 2024 Apple Inc.  All Rights reserved.
;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
;;; These are the sandbox entitlements for StocksKitService on macOS
(version 1)

;;; Training wheels on:
;;; (allow (with report) default)
;;; (allow (with report) file-map-executable process-info* nvram*)
;;; (allow (with report) dynamic-code-generation)

;;; Training wheels off:
(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Allow StocksKitService to perform networking
(allow network-outbound)

;; Allow StocksKitService a socket connection
(allow system-socket
    (socket-domain AF_SYSTEM))

;; Your preference domain
(allow user-preference-read user-preference-write
    (preference-domain "com.apple.AppleMediaServices")
    (preference-domain "group.com.apple.stocks")
    (preference-domain "com.apple.newscore")
    (preference-domain "com.apple.itunesstored")
    (preference-domain "com.apple.StocksKitService")
    (preference-domain "com.apple.stocks2")
    (preference-domain "com.apple.stocks.stockskit"))

(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication"))

;; Mach service lookup
(allow mach-lookup
    (global-name "com.apple.accountsd.accountmanager")
    (global-name "com.apple.adid")
    (global-name "com.apple.AppSSO.service-xpc")
    (global-name "com.apple.containermanagerd")
    (global-name "com.apple.CoreServices.coreservicesd")
    (global-name "com.apple.coreservices.quarantine-resolver")
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.metadata.mds")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration")
    (global-name "com.apple.usymptomsd")
    (global-name "com.apple.xpc.amsaccountsd")
    (global-name "com.apple.xpc.amsengagementd")
    (global-name "com.apple.xpc.amstoold"))

;; Read/write access to container
(allow file-read* file-write*
    (home-subpath "/Library/Group Containers/group.com.apple.stocks")
    (subpath (param "TMPDIR"))
    (subpath (param "DARWIN_CACHE_DIR"))
    (extension "com.apple.sandbox.container"))

;; Read-only access
(allow file-read*
    (literal "/Library/Preferences/com.apple.LaunchServices")
    (literal "/Library/Preferences/com.apple.networkd.plist")
    (literal "/private/var/db/mds/messages/501/se_SecurityMessages")
    (literal "/private/var/db/nsurlstoraged/dafsaData.bin")
    (home-regex #"/Library/Caches/com\.apple\.news\.public-[-\w.]*")
    (literal "/Library/Application Support/CrashReporter/DiagnosticMessagesHistory.plist")
    (subpath "/AppleInternal/Library/Bundles/NewsCoreInternalExtras.bundle"))

;; File map access
(allow file-map-executable
    (literal "/AppleInternal/Library/Bundles/NewsCoreInternalExtras.bundle/Contents/MacOS/NewsCoreInternalExtras"))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.StocksKitService")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; CoreImage access
(allow iokit-open-user-client
    (iokit-user-client-class "IOSurfaceRootUserClient"
                             "AppleParavirtDeviceUserClient"))
                             
;; For access to Metal
(system-graphics)

;; For drivers used by Metal (these may vary by GPU; match flexibly)
(allow file-map-executable
       (regex #"^/System/Library/Extensions/[A-Za-z0-9]+\.bundle/"))
