;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(import "system.sb")

(allow (with report) default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)
(deny network-outbound)
(deny network-bind)
(deny network-inbound)

(allow file-read* (literal "/Library/Preferences/com.apple.networkd.plist"))
(allow file-read* (literal "/Library/Preferences/com.apple.security.plist"))
(allow file-read* (subpath (param "SECURITY_MESSAGES_DIR")))
(allow file-read* (literal "/private/var/db/mds/system/mdsDirectory.db"))
(allow file-read* (literal "/private/var/db/mds/system/mdsObject.db"))
(allow ipc-posix-shm-read-data (ipc-posix-name "com.apple.AppleDatabaseChanged"))
(allow ipc-posix-shm-write-create (ipc-posix-name "com.apple.AppleDatabaseChanged"))
(allow ipc-posix-shm-write-data (ipc-posix-name "com.apple.AppleDatabaseChanged"))
(allow mach-lookup (global-name "com.apple.SecurityServer"))
(allow mach-lookup (global-name "com.apple.lsd.mapdb"))
(allow mach-lookup (global-name "com.apple.dnssd.service"))
(allow mach-lookup (global-name "com.apple.SystemConfiguration.configd"))
(allow mach-lookup (global-name "com.apple.containermanagerd"))
(allow system-socket (socket-domain AF_SYSTEM))
(system-network)
(allow network-outbound (remote ip) (local ip) (literal "/private/var/run/mDNSResponder"))
(allow user-preference*
    (preference-domain "group.com.apple.mail")
)
(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.email.AccountValidation"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR")))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.email.AccountValidation")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))
