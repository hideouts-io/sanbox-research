;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))

(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
    (preference-domain "com.apple.centaurid"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
    (subpath (param "TMPDIR"))
    (subpath (param "DARWIN_CACHE_DIR")))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.centaurid")))
    (allow file-read* file-write* cache-path-filter)
    (allow file-issue-extension
        (require-all
            (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
            cache-path-filter)))
      
;; Everything above here is the standard sandbox template from
;; https://confluence.sd.apple.com/display/OSSEC/How+To+Sandbox+a+Daemon+on+macOS
;; Below here are custom rules added for centaurid
      
(allow file-read*
    (subpath "/private/var/db/ConnectivityPowerTableUpdates")
    (literal "/usr/libexec")
    (literal "/usr/libexec/centaurid")
    (literal "/usr/local/standalone/firmware/Centauri/ftab.bin"))
    
(allow file-write*
    (literal "/private/tmp/Centauri")
    (literal "/private/tmp/Centauri/wifi-assert-strings.bin")
    (literal "/private/tmp/FTABHarvest")
    (literal "/private/tmp/FTABHarvest/centauri-custom-ftab.bin")
    (literal "/private/tmp/FTABHarvest/centauri-symlink-ftab.bin")
    (subpath "/private/var/db/ConnectivityPowerTableUpdates/Consumer"))

(allow iokit-open
    (iokit-user-client-class "AppleCentauriManagerUserClient")
    (iokit-user-client-class "AppleKeyStoreUserClient")
    (iokit-user-client-class "IOUserUserClient"))

(allow iokit-set-properties
    (iokit-user-client-class "AppleCentauriManagerUserClient"))

(allow mach-lookup
    (global-name "com.apple.bluetooth.xpc")
    (global-name "com.apple.distributed_notifications@1v3")
    (global-name "com.apple.duetactivityscheduler")
    (global-name "com.apple.osanalytics.osanalyticshelper")
    (global-name "com.apple.PowerManagement.control")
    (global-name "com.apple.remoted")
    (global-name "com.apple.usernotifications.listener"))

(allow distributed-notification-post)
(allow process-info-pidinfo)

(allow nvram-get
    (nvram-variable "centauri-boot-args"))
    
(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
    (preference-domain "com.apple.da"))
