;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable iokit-get-properties process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)
(system-network)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

(allow network-outbound)
(allow system-socket)
(allow distributed-notification-post)

(allow sysctl-write
       (sysctl-name "kern.tcsm_enable"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR")))

;; For internal daemon data containers
(allow file-read* file-write*
    (extension "com.apple.sandbox.container")
)

;; Allow issuing sandbox extension from daemon data container
(allow file-issue-extension
  (require-all
    (subpath (param "CONTAINER_CACHE_DIR"))
    (extension-class "com.apple.app-sandbox.read")
    (extension "com.apple.sandbox.container")))

;; IOKit Properties

(allow iokit-get-properties
    (iokit-property "IOBuiltin")
    (iokit-property "IOMACAddress"))

;;; Start jetpackassetd rules

;; Mach service

(allow mach-register
    (global-name "com.apple.aps.jetpackassetd"))

(allow mach-lookup
    (global-name "com.apple.nsurlsessiond")
    (global-name "com.apple.symptom_analytics")
    (global-name "com.apple.syncdefaultsd")
    (global-name "com.apple.usernotifications.listener")
    (global-name "com.apple.usernotifications.usernotificationservice")
    (global-name "com.apple.containermanagerd")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.windowserver.active")
    (global-name "com.apple.duetactivityscheduler")
    (global-name "com.apple.apsd")
    (global-name "com.apple.accountsd.accountmanager")
    (global-name "com.apple.ak.anisette.xpc")
    (global-name "com.apple.xpc.amsaccountsd")
    (global-name "com.apple.xpc.amsengagementd")
    (global-name "com.apple.fairplayd.versioned")
    (global-name "com.apple.fairplayd.xpc")
    (global-name "com.apple.fairplayd")
    (global-name "com.apple.fpsd")
    (global-name "com.apple.securityd.xpc")
)

;; Preference domains

(allow user-preference-read user-preference-write
    (preference-domain "com.apple.jetpackassetd")
    (preference-domain "com.apple.AppleMediaServices")
    (preference-domain "com.apple.itunesstored")
)

(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
)

(allow file-read*
    (literal "/Library/Application Support/CrashReporter/DiagnosticMessagesHistory.plist")
    (regex #"^/private/var/db/mds/messages/[^/]+/se_SecurityMessages(/|$)")
    (regex #"^/private/var/tmp/com\.apple\.jetpackassetd/overrides/.*\.jetpack$")
)

(allow file-read* file-write*
    (home-subpath "/Library/Caches/com.apple.jetpackassetd")
    (home-subpath "/Library/HTTPStorages/com.apple.jetpackassetd")
    (home-subpath "/Library/Caches/com.apple.AppleMediaServices")
)

;; Internal builds only

(with-filter (system-attribute apple-internal)
  (allow file-read*
         (subpath "/Library/Preferences/FeatureFlags"))     ; Feature Flags support
    (allow sysctl-write
         (sysctl-name "vm.task_no_footprint_for_debug")))   ; MallocStackLogging
