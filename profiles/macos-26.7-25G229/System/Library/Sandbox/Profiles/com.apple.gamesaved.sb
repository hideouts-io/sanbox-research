;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(import "appsandbox-common.sb")

(system-network)
(allow network-outbound)
(allow network-inbound)

;; For opening iCloud Settings
(allow lsopen)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))

(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.gamesaved"))

(allow user-preference-read
       (preference-domain "kCFPreferencesAnyApplication"))

(allow file-read-xattr)

(allow file-read*
    (literal "/usr/libexec")
    (literal "/usr/libexec/gamesaved"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR")))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.gamesaved")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))
      
;; rules for Sandbox extensions
(with-filter (extension "com.apple.app-sandbox.read")
  (allow file-read*)
  (allow file-issue-extension (extension-class "com.apple.app-sandbox.read")))

(with-filter (extension "com.apple.app-sandbox.read-write")
  (allow file-read* file-write*)
  (allow file-issue-extension (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")))
  
;; CloudDocs
(clouddocs)

(allow mach-lookup 
    (global-name "com.apple.bird")
    (global-name "com.apple.bird.token")
    (global-name "com.apple.FileProvider")
    (global-name "com.apple.coreservices.quarantine-resolver")
    (global-name "com.apple.coreservices.launchservicesd")
    (global-name "com.apple.lsd.modifydb")
    (global-name "com.apple.CoreServices.coreservicesd")
    (global-name "com.apple.DiskArbitration.diskarbitrationd")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.ak.auth.xpc")
    (global-name "com.apple.accountsd.accountmanager")
    (global-name "com.apple.tccd")
    (global-name "com.apple.distributed_notifications")
    (global-name "com.apple.distributed_notifications@Uv3")
    (global-name "com.apple.revisiond")
    (global-name "com.apple.mobile.usermanagerd.xpc")
    (global-name "com.apple.mobile.keybagd.UserManager.xpc")
    (global-name "com.apple.ProgressReporting")
    (global-name "com.apple.SystemConfiguration.configd"))
