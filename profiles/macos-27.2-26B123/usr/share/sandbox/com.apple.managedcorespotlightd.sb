;;; For macos: /System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/Metadata.framework/Versions/A/Support/managedcorespotlightd
(version 1)
(deny default)
(debug deny)
(import "system.sb")

(define (param-subpath param-name param-relative-subpath)
(subpath (string-append (param param-name) param-relative-subpath)))

(define (home-subpath home-relative-subpath)
(param-subpath "_HOME" home-relative-subpath))

(deny file-map-executable iokit-get-properties process-info* nvram*)

(allow file-read* (require-all (extension "com.apple.managedcorespotlightd.read-write")))
(allow file-write* (require-all (extension "com.apple.managedcorespotlightd.read-write")))

(allow file-read* (require-all (subpath "/Library/AssetsV2") (extension "com.apple.assets.read")))
(allow file-read* (require-all (subpath "/Library/LinguisticData") (extension "com.apple.assets.read")))

(allow file-read-metadata (home-subpath "/"))

(allow file-read* file-write*
    (home-subpath "/Library/Containers/com.apple.managedcorespotlightd")
    (home-subpath "/Library/Logs/CrashReporter/"))
    
(allow mach-lookup
    (global-name "com.apple.cache_delete")
    (global-name "com.apple.mobileassetd.v2")
    (global-name "com.apple.symptom_diagnostics")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.lsd.modifydb")
    (global-name "com.apple.spotlightknowledged")
    (global-name "com.apple.metadata.mds")
    (global-name "com.apple.tccd")
    (global-name "com.apple.tccd.system")
    (global-name "com.apple.spotlight.IndexAgent"))

(allow user-preference-read
    (preference-domain "com.apple.SoftwareUpdate")
    (preference-domain "com.apple.searchd")
    (preference-domain "com.apple.Spotlight")
    (preference-domain "com.apple.corespotlightui")
    (preference-domain "com.apple.SpotlightResources.Defaults")
    (preference-domain "kCFPreferencesAnyApplication"))
    
(allow process-info* (target self))

;; Allow fsctl(APFSIOC_VOLUME_CLASSKB_OP), fsctl(APFSIOC_FAST_PROMOTE_DATA), fsctl(HFSIOC_VOLUME_STATUS), fsctl(APFSIOC_DIR_STATS_OP), ffsctl(APFSIOC_MARK_PURGEABLE), ffsctl(APFSIOC_DIR_STATS_OP) for SpotlightIndexer
(allow system-fsctl
    (fsctl-command APFSIOC_VOLUME_CLASSKB_OP)
    (fsctl-command APFSIOC_MARK_PURGEABLE)
    (fsctl-command APFSIOC_DIR_STATS_OP)
    (fsctl-command HFSIOC_VOLUME_STATUS)
    (fsctl-command APFSIOC_FAST_PROMOTE_DATA))
