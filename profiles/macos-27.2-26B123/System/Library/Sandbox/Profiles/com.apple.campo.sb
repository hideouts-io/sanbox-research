(version 1)

(deny default)

;; for IIO_ReaderHandler::copySupportedTypes which loads entitlements on self
(allow process-legacy-codesigning-identity-get (target self))

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(import "appsandbox-common.sb")
(import "contacts.sb")


(corefoundation)
(system-graphics)
(contacts-client (param "HOME") (param "TMPDIR"))

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))

(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; Spotlight queries can return results from the entire disk.
;; So we have no choice but to let the process read
;; everything.
(allow file-read-data file-read-xattr)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

(allow user-preference-read user-preference-write
       (preference-domain "com.apple.addressbook")
       (preference-domain "com.apple.AppleMediaServices")
       (preference-domain "com.apple.campo")
       (preference-domain "com.apple.extensionspreferences.sharemenu")
       (preference-domain "com.apple.generativepartnerservicesettings")
       (preference-domain "com.apple.siri.generativeassistantsettings") ; external provider enablement
       (preference-domain "com.apple.siri.internal")
       (preference-domain "com.apple.siriviewservice")
       (preference-domain "com.apple.spotlight")
    )

(allow user-preference-read
    (preference-domain "kcfpreferencesanyapplication")
    (preference-domain "com.apple.universalaccess")
    (preference-domain "com.apple.accessibility")
    (preference-domain "com.apple.assistant")
    (preference-domain "com.apple.assistant.backedup")
    (preference-domain "com.apple.assistant.public")
    (preference-domain "com.apple.assistant.support")
    (preference-domain "com.apple.commerce")
    (preference-domain "com.apple.coregraphics")
    (preference-domain "com.apple.dictionaryservices")
    (preference-domain "com.apple.hitoolbox")
    (preference-domain "com.apple.ical")
    (preference-domain "com.apple.ids")
    (preference-domain "com.apple.imcorespotlight")
    (preference-domain "com.apple.imessage.bag")
    (preference-domain "com.apple.messages")
    (preference-domain "com.apple.messages.nicknames")
    (preference-domain "com.apple.parsecd")
    (preference-domain "com.apple.servicesmenu.services")
    (preference-domain "com.apple.siri.shortcuts")
    (preference-domain "com.apple.spotlightresources.defaults")
    (preference-domain "com.apple.suggestions")
    (preference-domain "com.apple.telephonyutilities")
    (preference-domain "com.apple.triald")
    (preference-domain "com.apple.duetexpertcenter.apppredictionexpert")
    (preference-domain "pbs"))
    
;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR")))

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.campo")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

(spotlight)

(allow system-audit)
(allow distributed-notification-post)
(allow lsopen)

(allow appleevent-send
    (appleevent-destination "com.apple.finder"))

