(allow file-read-data file-read-metadata
       (literal "/Library/Application Support/CrashReporter/DiagnosticMessagesHistory.plist")
       (subpath "/Library/Caches/com.apple.iconservices.store")
       (literal "/Library/Preferences/com.apple.networkd.plist")
       (subpath "/AppleInternal/System/Library/ExtensionKit/ExtensionPoints")
       (subpath "/private/var/folders")
       (subpath "/System/Library/AssetsV2/com_apple_MobileAsset_UAF_FM_Overrides")
