       (subpath "/System/Applications/Siri AI.app")
       (subpath "/System/Library/CoreServices/")
       (subpath "/usr/share/icu/")
)

; this matches a sandbox-check for "file-read*" specifically in NetworkExtension
(allow file-read* (literal "/Library/Preferences/com.apple.networkextension.uuidcache.plist"))

(allow iokit-open-user-client
