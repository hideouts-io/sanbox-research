(allow file-read* file-write*
       (home-subpath "/Library/com.apple.AppleMediaServices/PersistedBags/com.apple.campo")
       (home-subpath "/Library/Application Support/CampoUIInternal")
       (home-subpath "/Library/Application Support/com.apple.spotlight/")
