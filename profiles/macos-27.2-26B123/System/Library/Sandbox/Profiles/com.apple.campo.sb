(allow mach-lookup (local-name "com.apple.coredrag"))

(allow mach-lookup
       (xpc-service-name "com.apple.appkit.xpc.openAndSavePanelService")
       (xpc-service-name "com.apple.campo.apple-extension-service")
       (xpc-service-name "com.apple.TextInputUI.xpc.CursorUIViewService"))

(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read")
        (subpath "/System/Applications/Siri AI.app")))
        
(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read")
        (home-subpath "/Library/Metadata/CoreSpotlight/")))

; Needed for Spotlight photo queries. Can't scope this to ~/Pictures
; only since the photo library can live anywhere.
(allow file-issue-extension
    (extension-class "com.apple.managedcorespotlightd.read-write"))

;; We need to be able to create read sandbox extension for the whole disk as we
;; can potentially thumbnail any file in the search results.
(allow file-issue-extension (extension-class "com.apple.app-sandbox.read"))
    
    
;; For CoreServicesUIAgent to grant an app-sandbox.read-write extension to any search
;; result when opening it, we need to have write access to it in the first place.
;; (see URLSetSandboxExtensionForRealPathAndAuditToken).
(allow file-write-data)

;; Open the Photos library (QueryParser dependency)
(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
        (home-subpath "/Pictures/")))

;; Sharing a Photos asset from the Siri search grid:
(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
        (subpath (param "TMPDIR"))))

;; ShareKit writes its share-sheet preview icon to com.apple.sharekit.*
(allow file-read* file-write*
    (home-prefix "/Library/Caches/com.apple.sharekit")
    (home-prefix "/Library/Caches/.com.apple.sharekit"))

(allow network-outbound
       (literal "/private/var/run/mDNSResponder"))

(allow file-read*
       (home-subpath "/Library/Preferences/com.apple.LaunchServices/")
       (home-subpath "/Library/Mobile Documents/")
       (home-subpath "/Library/Metadata/CoreSpotlight/")
       (home-subpath "/Library/Application Support/com.apple.spotlight/")
       (home-subpath "/Library/Application Support/CrashReporter/")
