;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

;; Enabled sandboxing
(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)
(allow process-info-pidinfo (target others))

;; Preference domain
;; Allow reading powerlogd defaults — used by Powerlog client APIs in aned.
(allow user-preference-read (preference-domain "com.apple.powerlogd"))
(deny user-preference* (with no-report))

;; Read/write cache access
(let ((cache-path-filter (subpath "/Library/Caches/com.apple.aned")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; Open ane driver and io surface driver
(allow iokit-open
        (iokit-user-client-class "H11ANEInUserClient")
        (iokit-user-client-class "H1xANELoadBalancerClient")
        (iokit-user-client-class "IOSurfaceRootUserClient"))

;; Read aned
(allow file-read-data
        (literal "/usr/libexec")
        (literal "/usr/libexec/aned"))

;; For consumed read token from aned
(allow file-read* (extension "com.apple.aned.read-only"))
(allow file-read* (extension "com.apple.app-sandbox.read"))

;; For the clients that run inference on these model assets, aned loads them
;; directly (not via a sandbox extension), so explicit read access is required.
(allow file-read*
    (subpath "/System/Library/AssetsV2/com_apple_MobileAsset_UAF_AppleDepth_MLModel"))

;; Allow mach-lookup
(allow mach-lookup
    (global-name "com.apple.powerlog.plxpclogger.xpc")
    (global-name "com.apple.PerfPowerTelemetryClientRegistrationService")
    ;; Required for the model-type-based routing of LLIR/MLIR compiles to
    ;; ANELargeModelCompilerService. The regular ANECompilerService lookup
    ;; is implicitly allowed by the framework's co-bundled XPC mechanism;
    ;; ANELargeModelCompilerService doesn't get that implicit allow on
    ;; current builds and needs to be listed.
    (xpc-service-name "com.apple.ANELargeModelCompilerService")
)

;; Read/write access to a temporary directory.
(allow file-read* file-write*
    (subpath (param "TMPDIR")))
