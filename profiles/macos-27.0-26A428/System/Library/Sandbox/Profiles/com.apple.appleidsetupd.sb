;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)


;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex))
)

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath))
)

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix))
)

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal))
)


(allow process-info* (target self))


;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)


;; For validating the entitlements of clients.
(allow process-info-codesignature)


;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.appleidsetupd")
       (preference-domain "com.apple.mdmclient")
       (preference-domain "com.apple.security")
       (preference-domain "kCFPreferencesAnyApplication")
)


;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR"))
       (literal "/usr/libexec/appleidsetupd")
       (home-subpath "/Library/HTTPStorages/com.apple.appleidsetupd")
       (literal "/Library/Preferences/com.apple.networkd.plist")
)

;; Write access to logs.
(allow file-write*
       (literal "/Library/Logs/MCXTools.log")
)

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.appleidsetupd")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))


;; Filesystem read-only access
(allow file-read*
    (literal "/usr/libexec")
    (literal "/private/var/db/mds/messages/501/se_SecurityMessages")
    (literal "/Library/Keychains/System.keychain")
    (home-literal "/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist")
    (home-literal "/Library/Preferences/com.apple.Security.plist")
    (subpath "/AppleInternal/System/Library/ExtensionKit/ExtensionPoints")
    
)

;; File Map Executable
(allow file-map-executable
     (subpath "/System/Library/Accounts/ServiceOwners")
     (literal "/System/Library/CoreServices/ManagedClient.app/Contents/PlugIns/MCXToolsInterface.bundle/Contents/MacOS/MCXToolsInterface")
)

;; IOKit
(allow iokit-open
    (iokit-user-client-class "RootDomainUserClient")
)

;; Networking
(allow network-outbound)

(allow system-socket
    (socket-domain AF_SYSTEM)
)

;; Mach-lookup
(allow mach-lookup
    (global-name    "com.apple.icloud.findmydeviced")
    (global-name    "com.apple.aa.daemon.xpc")
    (global-name    "com.apple.accountsd.accountmanager")
    (global-name    "com.apple.ak.auth.xpc")
    (global-name    "com.apple.ak.anisette.xpc")
    (global-name    "com.apple.AppSSO.service-xpc")
    (global-name    "com.apple.cdp.daemon")
    (global-name    "com.apple.coreservices.quarantine-resolver")
    (global-name    "com.apple.dmd.policy")
    (global-name    "com.apple.identityservicesd.desktop.auth")
    (global-name    "com.apple.identityservicesd.embedded.auth")
    (global-name    "com.apple.logind")
    (global-name    "com.apple.lsd.mapdb")
    (global-name    "com.apple.lsd.modifydb")
    (global-name    "com.apple.metadata.mds")
    (global-name    "com.apple.mdmclient.agent.unrestricted")
    (global-name    "com.apple.PairingManager")
    (global-name    "com.apple.security.octagon")
    (global-name    "com.apple.SharingServices")
    (global-name    "com.apple.usymptomsd")
    (global-name    "com.apple.fpsd")
    (global-name    "com.apple.fairplayd")
    (global-name    "com.apple.fairplayd.xpc")
    (global-name    "com.apple.servicesanalytics.xpc")
)

