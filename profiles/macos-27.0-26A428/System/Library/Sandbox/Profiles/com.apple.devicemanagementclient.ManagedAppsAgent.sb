;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

;;; TODO: Change these to deny before finalizing this profile.
(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For proc_pidinfo
(allow process-info-pidinfo)

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.devicemanagementclient.managedappsd")
)

(allow user-preference-read
    (preference-domain "kCFPreferencesAnyApplication")
    (preference-domain "com.apple.mdmclient")
)

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR"))
       (subpath (param "DARWIN_CACHE_DIR"))
)

;; Read access
(allow file-read*
       (literal "/usr/libexec")
       (literal "/usr/libexec/managedappsd")
)

;; Read access to /Applications is required for SecCodeCopyGuestWithAttributes to resolve
;; an app's bundle path from its audit token. proc_pidpath() only returns the binary path
;; (e.g. .app/Contents/MacOS/Binary) rather than the bundle root (.app), and
;; NSRunningApplication does not reliably cover extensions.
;; As MACAPI expands to support processes outside /Applications
;; (e.g. /var/db/ManagedConfigurationFiles), consider switching to sandbox extension
;; donation from the calling process to avoid overly broad sandbox rules.
(allow file-read* (subpath "/Applications"))

;; Consuming Sandbox Extensions
(allow file-read* file-write* (extension "com.apple.app-sandbox.read-write"))
      
;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.devicemanagementclient.ManagedAppsAgent")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; Sandbox extension for download task URLs
(allow file-issue-extension
    (require-all
        (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
        (subpath "/private/var/containers/Data/ProtectedSystem/"))
)

;; Managed Preferences read access
(allow file-read*
    (subpath "/Library/Managed Preferences")
)

;; MCX - required for CP_InstallUserProfileData / CP_RemoveUserProfileWithIdentifier
(allow file-map-executable
    (literal "/System/Library/CoreServices/ManagedClient.app/Contents/PlugIns/MCXToolsInterface.bundle/Contents/MacOS/MCXToolsInterface")
)

;; mach services
(allow mach-lookup
    (global-name "com.apple.backupd.sandbox.xpc")
    (global-name "com.apple.containermanagerd.system")
    (global-name "com.apple.coreservices.quarantine-resolver")
    (global-name "com.apple.ctkd.token-client")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.lsd.modifydb")
    (global-name "com.apple.mdmclient.agent")
    (global-name "com.apple.mdmclient.agent.unrestricted")
    (global-name "com.apple.mdmclient.daemon")
    (global-name "com.apple.mdmclient.daemon.unrestricted")
    (global-name "com.apple.metadata.mds")
    (global-name "com.apple.mobile.keybagd.UserManager.xpc")
    (global-name "com.apple.mobile.usermanagerd.xpc")
    (global-name "com.apple.RemoteManagementAgent.store")
    (global-name "com.apple.securityd.xpc")
)
