;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

;;;;;;
;;; Restrictions
;;;;;;

(deny default)
(deny file-map-executable iokit-get-properties process-info* nvram*)
(deny dynamic-code-generation)

;;;;;;
;;; Imports
;;;;;;

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;;;;;
;;; Permissions
;;;;;;

;; Allow introspecting our own process info.
(allow process-info* (target self))

;; Allow resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; Allow validating the entitlements of clients.
(allow process-info-codesignature)

;; Container Manager
(with-filter (subpath "/private/var/containers/Data/ProtectedSystem")
  (allow file-read*
    (extension "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write"))
  (allow file-write*
    (extension "com.apple.app-sandbox.read-write"))
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      (extension "com.apple.app-sandbox.read-write"))))

;; Mach lookup access
(allow mach-lookup
  (global-name "com.apple.containermanagerd.system")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.system.opendirectoryd.api")
  (global-name "com.apple.SystemConfiguration.configd"))

;; User Preference Read
(allow user-preference-read
  (preference-domain "kcfpreferencesanyapplication"))

;; AppleInternal Access
(allow file-read*
    (subpath "/AppleInternal/DeviceConfiguration"))
