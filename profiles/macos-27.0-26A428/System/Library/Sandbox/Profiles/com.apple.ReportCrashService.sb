;;; Copyright (c) 2026 Apple Inc.  All Rights reserved.
;;;
;;; WARNING: The sandbox rules in this file currently constitute
;;; Apple System Private Interface and are subject to change at any time and
;;; without notice.
;;;
(version 1)

(allow (with report) default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference-read user-preference-write
       (preference-domain "com.apple.ReportCrashSerice"))

;; Read/write access to a temporary directory.
(allow file-read* file-write*
       (subpath (param "TMPDIR")))

;;; ============================================================================
;;; Rules derived from sandbox violation logs
;;; ============================================================================

;;; Process info operations
(allow process-info-pidinfo)

;;; Distributed notifications for crash reporting
(allow distributed-notification-post)

;;; Mach service lookups required for crash reporting
(allow mach-lookup
       (global-name "com.apple.backupd.sandbox.xpc")
       (global-name "com.apple.biome.access.system")
       (global-name "com.apple.bird")
       (global-name "com.apple.bird.token")
       (global-name "com.apple.containermanagerd")
       (global-name "com.apple.coreservices.launchservicesd")
       (global-name "com.apple.coreservices.quarantine-resolver")
       (global-name "com.apple.coresymbolicationd")
       (global-name "com.apple.diagnosticservicesd")
       (global-name "com.apple.logd.admin")
       (global-name "com.apple.lsd.advertisingidentifiers")
       (global-name "com.apple.lsd.mapdb")
       (global-name "com.apple.metadata.mds")
       (global-name "com.apple.mobile.keybagd.UserManager.xpc")
       (global-name "com.apple.mobile.usermanagerd.xpc")
       (global-name "com.apple.oahd")
       (global-name "com.apple.remoted")
       (global-name "com.apple.ReportMemoryException")
       (global-name "com.apple.system.opendirectoryd.api")
       (global-name "com.apple.trial.status"))

;;; Launch Services open operation
(allow lsopen)

;;; IOKit user clients for keystore and power management
(allow iokit-open-user-client
       (iokit-user-client-class "AppleKeyStoreUserClient")
       (iokit-user-client-class "ApplePMGRUserClient"))

;;; Sysctl writes for memory footprint tracking
(allow sysctl-write
       (sysctl-name "vm.self_region_footprint")
       (sysctl-name "vm.self_region_page_size")
       (sysctl-name "vm.get_owned_vmobjects"))

;;; File access for OSAnalytics preferences
(allow file-read-data
       (subpath "/Library/OSAnalytics/Preferences"))

;;; File access for dSYM symbol files (for symbolication)
(allow file-read*
       (subpath "/usr/local/bin")
       (regex #"\.dSYM/"))

;;; File access for CrashReporter preferences (system-wide)
(allow file-read* file-write*
       (subpath "/Library/Application Support/CrashReporter"))

;;; File access for user-specific CrashReporter and Trial data
(allow file-read* file-write*
       (home-subpath "/Library/Application Support/CrashReporter")
       (home-subpath "/Library/Trial/NamespaceDescriptors"))

;;; File access for containerized app CrashReporter data (e.g., Safari, etc.)
(allow file-read* file-write*
       (home-regex #"/Library/Containers/[^/]+/Data/Library/Application Support/CrashReporter/"))

;;; File access for diagnostics logs (os_log trace files)
(allow file-read*
       (subpath "/private/var/db/diagnostics")
       (subpath "/private/var/db/uuidtext"))

;;; File issue extension for DiagnosticReports
(allow file-issue-extension
       (require-all
         (extension-class "com.apple.osanalytics-sandbox.read-write")
         (home-subpath "/Library/Logs/DiagnosticReports")))
