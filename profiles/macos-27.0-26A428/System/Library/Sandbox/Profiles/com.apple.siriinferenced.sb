(version 1)

(deny default)
(deny file-map-executable process-info* nvram*)
(deny dynamic-code-generation)

(deny mach-priv-host-port)

(import "system.sb")
(import "com.apple.corefoundation.sb")
(corefoundation)

;;; Homedir-relative path filters
(define (home-regex home-relative-regex)
    (regex (string-append "^" (regex-quote (param "HOME")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
    (subpath (string-append (param "HOME") home-relative-subpath)))

(define (home-prefix home-relative-prefix)
    (prefix (string-append (param "HOME") home-relative-prefix)))

(define (home-literal home-relative-literal)
    (literal (string-append (param "HOME") home-relative-literal)))


(allow process-info* (target self))
(allow process-info-dirtycontrol (target self))

;; For resolving symlinks, realpath(3), and equivalents.
(allow file-read-metadata)

;; For validating the entitlements of clients.
(allow process-info-codesignature)

;; Your preference domain
(allow user-preference*
       (preference-domain "com.apple.siriinferenced")
       (preference-domain "com.apple.assistant")
       (preference-domain "com.apple.assistant.backedup")
       (preference-domain "com.apple.assistant.support")
       (preference-domain "com.apple.siri.analytics.assistant")
       (preference-domain "com.apple.siri.sirisuggestions")
       (preference-domain "com.apple.siri.DialogEngine")
       (preference-domain "com.apple.siriinferenced.AppOrdering")
       (preference-domain "kCFPreferencesAnyApplication"))
       
(allow user-preference-read (preference-domain "com.apple.homed.notbackedup"))

(allow managed-preference-read (preference-domain "kCFPreferencesAnyApplication"))


(allow mach-lookup
    (global-name "com.apple.siri.uaf.service")
    (global-name "com.apple.siri.uaf.subscription.service")
    (global-name "com.apple.system.opendirectoryd.api")
    (global-name "com.apple.siri.analytics.assistant")
    (global-name "com.apple.mobileassetd.v2")
    (global-name "com.apple.biome.compute.source.user")
    (global-name "com.apple.biome.compute.publisher.service.user")
    (global-name "com.apple.biome.access.user")
    (global-name "com.apple.biome.access.system")
    (global-name "com.apple.containermanagerd")
    (global-name "com.apple.coreduetd.knowledge.user")
    (global-name "com.apple.routined.registration")
    (global-name "com.apple.intelligenceplatform.View")
    (global-name "com.apple.intelligenceplatform.EntityResolution")
    (global-name "com.apple.homed.xpc")
    (global-name "com.apple.linkd.registry")
    (global-name "com.apple.extensionkitservice")
    (global-name "com.apple.biome.PublicStreamAccessService")
    (global-name "com.apple.biomesyncd.sync")
    (global-name "com.apple.calaccessd")
    (global-name "com.apple.analyticsd")
    (global-name "com.apple.remindd")
    (global-name "com.apple.suggestd.contacts")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.privacyaccountingd")
    (global-name "com.apple.coremedia.routingcontext.xpc")
    (global-name "com.apple.locationd.registration")
    (global-name "com.apple.coremedia.volumecontroller.xpc")
    (global-name "com.apple.coremedia.routediscoverer.xpc")
    (global-name "com.apple.mediaremoted.xpc")
    (global-name "com.apple.linkd.registry")
    (global-name "com.apple.linkd.suggestions")
    (global-name "com.apple.frontboard.systemappservices")
    (global-name "com.apple.springboard.backgroundappservices")
    (global-name "com.apple.identityservicesd.embedded.auth")
    (global-name "com.apple.ak.auth.xpc")
    (global-name "com.apple.accountsd.accountmanager")
    (global-name "com.apple.audio.AudioSession")
    (global-name "com.apple.backlightd")
    (global-name "com.apple.itunescloud.music-subscription-status-service")
    (global-name "com.apple.Maps.xpc.SharedTrip")
    (global-name "com.apple.siriknowledged")
    (global-name "com.apple.icloud.fmfd")
    (global-name "com.apple.intelligenceflow.context")
    (global-name "com.apple.linkd.transcript")
    (global-name "com.apple.linkd.mediator")
    (global-name "com.apple.linkd.registry")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.lsd.modifydb")
    (global-name "com.apple.coreservices.quarantine-resolver")
    (global-name "com.apple.tccd")
    (global-name "com.apple.CallHistorySyncHelper")
    (global-name "com.apple.coreservices.launchservicesd") 
)



;; Read/write access to a temporary directory.
(allow file-read* file-write*
        (home-subpath "/Library/Application Support/com.apple.siri.inference/")
        (home-subpath "/Library/Group Containers/group.com.apple.siri.inference/")
        (home-subpath "/Library/Group Containers/group.com.apple.siri.remembers/")
        (home-subpath "/Library/Caches/com.apple.HomeKit/com.apple.siriinferenced/")
        (home-subpath "/Library/Caches/com.apple.siriinferenced/")
        (home-subpath "/Library/com.apple.siri.inference/")
        (home-subpath "/Library/srtest/")
        (home-subpath "/Library/Preferences/com.apple.suggestions.plist")
        (home-subpath "/Library/Assistant/")
        (home-subpath "/Library/Shortcuts/ToolKit/")
        (home-subpath "/Library/Logs/com.apple.FeatureStore/")
        (home-subpath "/Library/Assistant/SiriReferenceResolution/")
        (home-subpath "/Library/IntelligencePlatform/Artifacts/siri/remembers/")
)

(allow file-map-executable
       (subpath "/System/Library/Assistant/Suggestions/InferenceBridge/SiriSuggestionsInferenceBridge.bundle")
       (subpath "/System/Library/Siri/DM/SiriSuggestions/Owners"))

(allow file-read*
        (subpath "/AppleInternal/Library/")
        (subpath "/Library/Preferences/")
        (subpath "/private/var/db/assetsubscriptiond/")
        (home-subpath "/Library/Preferences/com.apple.LaunchServices")
        (home-subpath "/Library/Trial/Treatments/")
        (home-subpath "/Library/Trial/")
        (home-subpath "/Library/DuetExpertCenter/UICaches/SiriDiscoverability/")
        (home-subpath "/Library/Application Support/CallHistoryDB")
)

(allow file-read* file-write*
    (extension "com.apple.sandbox.application-group"))

(allow file-issue-extension (extension-class "/System/Applications/"))

(allow lsopen)

;; Read/write cache access
(let ((cache-path-filter (home-subpath "/Library/Caches/com.apple.siriinferenced")))
  (allow file-read* file-write* cache-path-filter)
  (allow file-issue-extension
    (require-all
      (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")
      cache-path-filter)))

;; Allow posting distributed notifications
(allow distributed-notification-post)

;; Consume sandbox extensions
(with-filter (extension "com.apple.app-sandbox.read")
    (allow file-read*)
    (allow file-issue-extension (extension-class "com.apple.app-sandbox.read")))
(with-filter (extension "com.apple.app-sandbox.read-write")
    (allow file-read* file-write*)
    (allow file-issue-extension (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")))

;; Contacts
(import "contacts.sb")
(contacts-client (param "HOME") (param "TMPDIR"))
